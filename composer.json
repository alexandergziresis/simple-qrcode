{
    "name": "alexandergziresis/simple-qrcode",
    "type": "library",
    "description": "Modern QR Code generator for Laravel based on SimpleSoftwareIO/simple-qrcode.",
    "keywords": ["qrcode", "laravel", "simple", "generator", "wrapper"],
    "homepage": "https://github.com/alexandergziresis/simple-qrcode",
    "license" : "MIT",
    "authors": [
        {
            "name": "Alexander Guiza",
            "email": "alexander@iresis.co"
        }
    ],
    "require": {
        "php": ">=7.2|^8.0",
      	"ext-gd": "*",
        "bacon/bacon-qr-code": "^2.0|^3.0"
    },
    "replace": {
        "simplesoftwareio/simple-qrcode": "self.version"
    },
    "require-dev": {
        "mockery/mockery": "~1",
        "phpunit/phpunit": "~9"
    },
    "suggest": {
        "ext-imagick": "Allows the generation of PNG QrCodes.",
        "illuminate/support": "Allows for use within Laravel."
    },
    "autoload": {
        "psr-4": {
            "SimpleSoftwareIO\\QrCode\\": "src"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "SimpleSoftwareIO\\QrCode\\QrCodeServiceProvider"
            ],
            "aliases": {
                "QrCode": "SimpleSoftwareIO\\QrCode\\Facades\\QrCode"
            }
        }
    }
}
